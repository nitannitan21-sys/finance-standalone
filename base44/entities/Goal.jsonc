{
  "name": "Goal",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "target": {
      "type": "number",
      "default": 0
    },
    "current": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "target"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
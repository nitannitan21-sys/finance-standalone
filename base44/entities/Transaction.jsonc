{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense",
        "transfer"
      ],
      "default": "expense"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string",
      "default": ""
    },
    "account_id": {
      "type": "string"
    },
    "to_account_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "note": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "type",
    "date",
    "account_id",
    "amount"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}